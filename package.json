{
  "name": "secureprompt-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for SecurePrompt library",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "serve": "http-server . -a 127.0.0.1 -p 8000 -c-1",
    "dev:lib": "npm run dev -w secureprompt",
    "dev": "concurrently -k \"npm:serve\" \"npm:dev:lib\""
  },
  "keywords": [
    "llm",
    "sanitization",
    "security",
    "prompt-injection",
    "pii-detection"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "http-server": "^14.1.1"
  }
}
